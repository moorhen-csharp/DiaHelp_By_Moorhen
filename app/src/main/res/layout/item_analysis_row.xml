<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvRowLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Показатель" android:textSize="14sp" android:textStyle="bold" android:textColor="?attr/colorOnSurface"/>
        <TextView android:id="@+id/tvRowNorm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Норма: —" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="2dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
        <TextView android:id="@+id/tvRowValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="20sp" android:textStyle="bold" android:textColor="?attr/colorOnSurface" android:gravity="end"/>
        <TextView android:id="@+id/tvRowStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:gravity="end" android:layout_marginTop="1dp"/>
    </LinearLayout>
</LinearLayout>