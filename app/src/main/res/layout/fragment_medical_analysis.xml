<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ══════════════════════════════════════════════════
         РЕЖИМ ПРОСМОТРА
    ══════════════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/viewModeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- Заголовок + кнопка редактирования -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/viewTitleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Анализ крови"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnBackground"/>

                    <TextView
                        android:id="@+id/viewDateText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Данные не введены"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- Кнопка редактирования -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Изменить"
                    android:textColor="@color/color_text"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"
                    app:cornerRadius="12dp"/>
            </LinearLayout>

            <!-- Состояние: нет данных -->
            <LinearLayout
                android:id="@+id/emptyStateView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="60dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋"
                    android:textSize="48sp"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Анализы ещё не вводились"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Нажмите «Изменить» чтобы добавить результаты"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Карточки просмотра данных -->
            <LinearLayout
                android:id="@+id/dataView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <!-- HbA1c — акцентная карточка -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHba1cView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#1565C0"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⭐  Гликированный гемоглобин"
                                android:textSize="14sp"
                                android:textColor="#90CAF9"/>

                            <TextView
                                android:id="@+id/tvHba1cValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="36sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:layout_marginTop="4dp"/>

                            <TextView
                                android:id="@+id/tvHba1cStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="13sp"
                                android:textColor="#90CAF9"
                                android:layout_marginTop="4dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Норма: &lt; 7%"
                                android:textSize="12sp"
                                android:textColor="#90CAF9"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HbA1c"
                            android:textSize="13sp"
                            android:textColor="#90CAF9"
                            android:background="#1976D2"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Показатели крови -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBloodView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutline"
                    app:cardBackgroundColor="?attr/colorSurface"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🩸  Показатели крови"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="16dp"/>

                        <include layout="@layout/item_analysis_row"
                            android:id="@+id/rowCpeptide"/>
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="?attr/colorOutline" android:layout_marginVertical="10dp"/>
                        <include layout="@layout/item_analysis_row"
                            android:id="@+id/rowHemoglobin"/>
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="?attr/colorOutline" android:layout_marginVertical="10dp"/>
                        <include layout="@layout/item_analysis_row"
                            android:id="@+id/rowLeukocytes"/>
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="?attr/colorOutline" android:layout_marginVertical="10dp"/>
                        <include layout="@layout/item_analysis_row"
                            android:id="@+id/rowPlatelets"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Липидный профиль -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLipidsView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutline"
                    app:cardBackgroundColor="?attr/colorSurface"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💊  Липидный профиль"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="16dp"/>

                        <include layout="@layout/item_analysis_row" android:id="@+id/rowCholesterol"/>
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="?attr/colorOutline" android:layout_marginVertical="10dp"/>
                        <include layout="@layout/item_analysis_row" android:id="@+id/rowHdl"/>
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="?attr/colorOutline" android:layout_marginVertical="10dp"/>
                        <include layout="@layout/item_analysis_row" android:id="@+id/rowLdl"/>
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="?attr/colorOutline" android:layout_marginVertical="10dp"/>
                        <include layout="@layout/item_analysis_row" android:id="@+id/rowTriglycerides"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Биохимия -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBiochemView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutline"
                    app:cardBackgroundColor="?attr/colorSurface"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔬  Биохимия"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="16dp"/>

                        <include layout="@layout/item_analysis_row" android:id="@+id/rowCreatinine"/>
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="?attr/colorOutline" android:layout_marginVertical="10dp"/>
                        <include layout="@layout/item_analysis_row" android:id="@+id/rowUrea"/>
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="?attr/colorOutline" android:layout_marginVertical="10dp"/>
                        <include layout="@layout/item_analysis_row" android:id="@+id/rowAlt"/>
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="?attr/colorOutline" android:layout_marginVertical="10dp"/>
                        <include layout="@layout/item_analysis_row" android:id="@+id/rowAst"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ══════════════════════════════════════════════════
         РЕЖИМ РЕДАКТИРОВАНИЯ
    ══════════════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/editModeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- Заголовок редактирования -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/editTitleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Редактирование"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnBackground"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Заполните нужные поля"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurfaceVariant"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelEdit"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Отмена"
                    android:textColor="?attr/colorError"/>
            </LinearLayout>

            <!-- HbA1c -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHba1cEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#1565C0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⭐  Гликированный гемоглобин"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HbA1c"
                            android:textSize="12sp"
                            android:textColor="#90CAF9"
                            android:background="#1976D2"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"/>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:suffixText="%"
                        app:suffixTextColor="#90CAF9"
                        app:boxStrokeColor="#90CAF9"
                        app:hintTextColor="#90CAF9"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/hba1cInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textAlignment="center"
                            android:hint="0.0"
                            android:textColorHint="#60FFFFFF"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Норма: &lt; 7% при диабете 1 типа"
                        android:textSize="12sp"
                        android:textColor="#90CAF9"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Показатели крови (редактирование) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBloodEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutline"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🩸  Показатели крови"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="16dp"/>

                    <include layout="@layout/item_edit_row" android:id="@+id/editCpeptide"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="?attr/colorOutline" android:layout_marginVertical="12dp"/>
                    <include layout="@layout/item_edit_row" android:id="@+id/editHemoglobin"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="?attr/colorOutline" android:layout_marginVertical="12dp"/>
                    <include layout="@layout/item_edit_row" android:id="@+id/editLeukocytes"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="?attr/colorOutline" android:layout_marginVertical="12dp"/>
                    <include layout="@layout/item_edit_row" android:id="@+id/editPlatelets"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Липидный профиль (редактирование) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLipidsEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutline"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💊  Липидный профиль"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="16dp"/>

                    <include layout="@layout/item_edit_row" android:id="@+id/editCholesterol"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="?attr/colorOutline" android:layout_marginVertical="12dp"/>
                    <include layout="@layout/item_edit_row" android:id="@+id/editHdl"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="?attr/colorOutline" android:layout_marginVertical="12dp"/>
                    <include layout="@layout/item_edit_row" android:id="@+id/editLdl"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="?attr/colorOutline" android:layout_marginVertical="12dp"/>
                    <include layout="@layout/item_edit_row" android:id="@+id/editTriglycerides"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Биохимия (редактирование) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBiochemEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutline"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔬  Биохимия"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="16dp"/>

                    <include layout="@layout/item_edit_row" android:id="@+id/editCreatinine"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="?attr/colorOutline" android:layout_marginVertical="12dp"/>
                    <include layout="@layout/item_edit_row" android:id="@+id/editUrea"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="?attr/colorOutline" android:layout_marginVertical="12dp"/>
                    <include layout="@layout/item_edit_row" android:id="@+id/editAlt"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="?attr/colorOutline" android:layout_marginVertical="12dp"/>
                    <include layout="@layout/item_edit_row" android:id="@+id/editAst"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Кнопка Сохранить -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Сохранить анализы"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/color_button"
                android:textColor="@color/color_text_button"
                app:icon="@drawable/ic_save"
                app:iconGravity="textStart"
                app:iconPadding="8dp"/>

        </LinearLayout>
    </ScrollView>

</FrameLayout>